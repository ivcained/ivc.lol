---
// First-load moment: the tube warms up, the tuner sweeps the band.
import { site } from '../data/site';
---
<div id="loader" role="status" aria-label="Loading">
  <div class="loader__inner">
    <span class="loader__name" data-loader-out>{site.wordmark}</span>
    <span class="loader__count" data-loader-out data-loader-count>87.5 MHz</span>
  </div>
  <div class="loader__bar" data-loader-bar></div>
</div>
